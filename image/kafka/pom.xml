<?xml version="1.0" encoding="UTF-8"?>
<!-- Connecteur Kafka de Spark et ses dépendances, résolus par Maven pendant la construction de l'image (image/Dockerfile).
     Seuls les jars absents de Spark sont ajoutés à l'image : ceux que Spark fournit déjà (scope provided, ou même
     artefact dans /opt/spark/jars) gardent la version de Spark. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fr.lakehouse</groupId>
  <artifactId>dependances-kafka</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <dependencies>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql-kafka-0-10_2.13</artifactId>
      <version>4.1.3</version>
    </dependency>
  </dependencies>
</project>
