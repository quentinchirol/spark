// Environnement de développement prêt à l'emploi (GitHub Codespaces ou VS Code Dev Containers).
// Contient : Python 3.12, Java 21, Docker (dans le conteneur), kubectl, Helm et kind.
// Démarrer la stack complète dans un cluster local : scripts/dev/demarrer-kind.sh
{
  "name": "Data Lakehouse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    },
    "ghcr.io/devcontainers-extra/features/kind:1": {}
  },
  // la stack complète réserve ~11,5 Go : machine Codespaces 4 cœurs / 16 Go minimum
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [15002, 8443, 4040],
  "portsAttributes": {
    "15002": { "label": "Spark Connect" },
    "8443": { "label": "Trino (HTTPS)" },
    "4040": { "label": "UI Spark" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  }
}
